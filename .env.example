# Copy to .env for local development. NEVER commit the real .env file.
# Server-side Supabase credentials (use the secret/service key ONLY on the server).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_KEY=YOUR-SERVER-SIDE-KEY

# Public address of the deployed app, used to build join links and QR codes.
# Leave empty to disable links/QR (the subject code still works).
APP_BASE_URL=

# Optional recognition tuning
FACE_MATCH_THRESHOLD=0.6
VOICE_MATCH_THRESHOLD=0.65

# --- account security (see docs/SECURITY.md) ---
# One-time secret for creating the FIRST administrator. Set it, create the admin, then REMOVE it.
ADMIN_SETUP_TOKEN=
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
STUDENT_REGISTER_PER_HOUR=30
